# Production backend environment template
# Copy values into your cloud host dashboard (Render/Railway/etc).

NODE_ENV=production
API_URL=https://api.yourdomain.com
TRUST_PROXY=1
ENABLE_SWAGGER_DOCS=false
SWAGGER_DOCS_TOKEN=replace-with-docs-access-token-if-docs-enabled

# Explicit frontend origins allowed by CORS
# No localhost or wildcard in production.
ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com,https://yourdomain.com

# Firestore credentials (server-side only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional alternative:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JWT
JWT_SECRET=replace-with-a-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-64-byte-random-secret
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Maps backend proxy key (server key, not app-restricted Android key)
GOOGLE_MAPS_API_KEY=your-valid-server-maps-key

# Optional tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_METRICS_PERSIST=true
RATE_LIMIT_METRICS_INTERVAL_MS=300000
RATE_LIMIT_STORE=firestore
REQUEST_BODY_LIMIT=1mb
REQUEST_URLENCODED_LIMIT=1mb

# Optional error-tracking webhook
ERROR_TRACKING_ENABLED=true
ERROR_WEBHOOK_URL=https://hooks.example.com/services/replace-me
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.05

# Query guardrails
BUSINESS_SEARCH_FETCH_LIMIT=500
BUSINESS_SEARCH_FETCH_LIMIT_MAX=250
ANALYTICS_SUMMARY_SCAN_LIMIT=2000
ADMIN_USER_SEARCH_SCAN_LIMIT=500
PLACES_SYNC_PULL_DEFAULT_LIMIT=500
PLACES_SYNC_PULL_MAX_LIMIT=1000
MAPS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
MAPS_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Deployment assertions
FIRESTORE_BACKUP_ENABLED=true
CLOUD_RUN_MEMORY_MB=2048
DEPLOYMENT_IAM_VALIDATED=true
DEPLOYMENT_INDEXES_VALIDATED=true
PREDEPLOY_STRICT=true
