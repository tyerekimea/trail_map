# Production backend environment template
# Copy values into your cloud host dashboard (Render/Railway/etc).

NODE_ENV=production
API_URL=https://api.yourdomain.com

# Explicit frontend origins allowed by CORS
ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# Firestore credentials (server-side only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional alternative:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JWT
JWT_SECRET=replace-with-a-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-64-byte-random-secret
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Maps backend proxy key (server key, not app-restricted Android key)
GOOGLE_MAPS_API_KEY=your-valid-server-maps-key

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret
PAYSTACK_CALLBACK_URL=https://api.yourdomain.com/subscription/callback

# Optional tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
