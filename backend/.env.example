# Prefer setting these in project root `.env` so values are shared globally.
# This file remains as a reference template for backend-specific variables.

# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Alternative to the three values above:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Paystack (Nigerian Payment Gateway)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
PAYSTACK_CALLBACK_URL=https://yourdomain.com/subscription/callback

# AdMob (for ads)
ADMOB_APP_ID=ca-app-pub-your-admob-app-id
ADMOB_BANNER_ID=ca-app-pub-your-banner-id
ADMOB_INTERSTITIAL_ID=ca-app-pub-your-interstitial-id

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
# Comma-separated explicit origins, no wildcard
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Admin Credentials
ADMIN_EMAIL=admin@mapsnigeria.com
ADMIN_PASSWORD=change-this-secure-password

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# AWS S3 (for photo uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=maps-nigeria-uploads
AWS_REGION=us-east-1

# Cloudinary (alternative for images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
