{
  "name": "maps-nigeria-backend",
  "version": "1.0.0",
  "description": "Backend API for Google Maps Nigeria App",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=true jest --runInBand test/routes/*-advanced.test.js",
    "test:production-gate": "jest --coverage --config jest.production.config.js --runInBand",
    "lint": "eslint src/**/*.js",
    "check:prod-env": "node scripts/check-prod-env.js",
    "check:predeploy": "node scripts/predeploy-check.js"
  },
  "keywords": [
    "maps",
    "navigation",
    "nigeria",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^8.55.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
