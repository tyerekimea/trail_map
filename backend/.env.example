# Prefer setting these in project root `.env` so values are shared globally.
# This file remains as a reference template for backend-specific variables.

# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
TRUST_PROXY=1
ENABLE_SWAGGER_DOCS=true
SWAGGER_DOCS_TOKEN=

# Database (Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Alternative to the three values above:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE=3600
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_METRICS_PERSIST=false
RATE_LIMIT_METRICS_INTERVAL_MS=300000
RATE_LIMIT_STORE=memory

# Request size limits
REQUEST_BODY_LIMIT=1mb
REQUEST_URLENCODED_LIMIT=1mb

# Maps API resilience
MAPS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
MAPS_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# CORS
# Comma-separated explicit origins, no wildcard
ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com

# Error tracking webhook (optional)
ERROR_TRACKING_ENABLED=false
ERROR_WEBHOOK_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Admin Credentials
ADMIN_EMAIL=admin@mapsnigeria.com
ADMIN_PASSWORD=change-this-secure-password

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Search/admin query guardrails
BUSINESS_SEARCH_FETCH_LIMIT=500
BUSINESS_SEARCH_FETCH_LIMIT_MAX=250
ANALYTICS_SUMMARY_SCAN_LIMIT=2000
ADMIN_USER_SEARCH_SCAN_LIMIT=500
PLACES_SYNC_PULL_DEFAULT_LIMIT=500
PLACES_SYNC_PULL_MAX_LIMIT=1000

# Pre-deployment checks (set to true after verification)
FIRESTORE_BACKUP_ENABLED=false
CLOUD_RUN_MEMORY_MB=2048
DEPLOYMENT_IAM_VALIDATED=false
DEPLOYMENT_INDEXES_VALIDATED=false
PREDEPLOY_STRICT=false
